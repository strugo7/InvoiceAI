GEMINI_API_KEY=your_google_ai_studio_key_here
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# --- Google OAuth (Web flow) ---
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- Sessions & token encryption ---
SESSION_SECRET=generate_with_python_secrets_token_urlsafe_48
TOKEN_ENC_KEY=generate_with_cryptography_fernet_generate_key

# --- Google Sheets target (moved out of tracked config.json) ---
SHEET_ID=your_google_sheet_id_or_url_here

# --- Scan guardrails (optional; defaults shown) ---
# How far back Gmail is searched, in days (caps the result set).
SCAN_LOOKBACK_DAYS=90
# Hard cap on messages processed per scan (also caps paid Gemini calls).
MAX_EMAILS_PER_SCAN=300
